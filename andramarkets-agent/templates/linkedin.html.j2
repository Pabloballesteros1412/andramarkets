<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><style>{{ social_css }}
@page{ size:1200px 1500px; margin:0; } html,body{ width:1200px; }
</style></head><body class="li">

<!-- 01 · COVER. Headline carries the frame; the S&P line runs off both edges. -->
<div class="f ink">
  <div class="rh"><span>Andra Markets</span><span>{{ date_short }}</span></div>
  <div class="hair" style="margin-top:26px"></div>
  <div style="margin-top:110px">
    <div class="lbl muted" style="margin-bottom:34px">US market close</div>
    <div class="dsp" style="max-width:1000px">{{ n.headline }}</div>
  </div>
  <div class="lbl muted" style="position:absolute;left:80px;bottom:352px">
    S&amp;P 500 · last 60 sessions</div>
  <div class="bleed-wrap" style="bottom:0;height:300px">
    <img class="bleed" src="{{ s.spark_light }}" style="height:300px;object-fit:fill">
  </div>
</div>

<!-- 02 · THE NUMBER. One figure, oversized, weighted to the lower left. -->
<div class="f">
  <div class="rh muted"><span>{{ s.hero.label }}</span><span></span></div>
  <div class="stack" style="margin-bottom:40px">
    <div class="fig {{ s.hero.dir }}" style="margin-left:-14px">{{ s.hero.value }}</div>
    <div class="hair" style="margin:44px 0 34px 0"></div>
    <p style="max-width:820px">{{ s.hero.note }}</p>
  </div>
  <div class="pg">02</div>
</div>

<!-- 03 · SECTORS. Bars built in type, not plotted. -->
<div class="f">
  <div class="lbl muted">Sector rotation</div>
  <div class="dsp sm" style="margin:30px 0 54px 0">Where the money went</div>
  <div class="bars">
    {% for b in s.sectors %}
    <div class="bar-row">
      <div class="bar-name">{{ b.name }}</div>
      <div class="bar-track"><div class="bar-zero"></div>
        <div class="bar-fill {{ b.dir }}" style="width:{{ b.width }}%;{{ b.side }}:50%;background:currentColor"></div>
      </div>
      <div class="bar-val {{ b.dir }}">{{ b.value }}</div>
    </div>
    {% endfor %}
  </div>
  <div class="pg">03</div>
</div>

<!-- 04 · PULL. Green field, one sentence, space above it. -->
<div class="f field">
  <div class="lbl muted">Takeaway</div>
  <div class="stack" style="margin-bottom:70px">
    <img src="{{ s.mark_light }}" style="width:300px;display:block;margin-bottom:44px">
    <div class="say" style="max-width:930px">{{ n.takeaways[0] }}</div>
  </div>
  <div class="pg">04</div>
</div>

<!-- 05 · CURVE. Line art, tenors set in type below it. -->
<div class="f">
  <div class="lbl muted">US Treasury curve</div>
  <div class="dsp sm" style="margin:30px 0 0 0">The long end did the work</div>
  <div style="margin-top:70px">
    <img class="bleed" src="{{ s.curve_img }}" style="height:390px;object-fit:fill">
    <div class="tenors" style="margin-top:24px">
      {% for t in s.tenors %}<span>{{ t }}</span>{% endfor %}
    </div>
  </div>
  <div class="stack" style="margin-bottom:44px">
    {% for sl in slopes %}
    <div class="row"><span class="n">{{ sl.name }}</span>
      <span><span class="v">{{ sl.bp | num(1) }}</span>
      <span class="d {{ sl.delta | dir }}" style="margin-left:16px">{{ sl.delta | bp }}</span></span></div>
    {% endfor %}
  </div>
  <div class="pg">05</div>
</div>

<!-- 06 · THE TAPE. Rows, not a table. -->
<div class="f ink">
  <div class="lbl muted">Across the board</div>
  <div class="dsp sm" style="margin:30px 0 50px 0">Where things settled</div>
  {% for r in s.tape %}
  <div class="row"><span class="n">{{ r.name }}</span>
    <span><span class="v">{{ r.last }}</span>
    <span class="d {{ r.dir }}" style="margin-left:20px">{{ r.chg }}</span></span></div>
  {% endfor %}
  <div class="pg">06</div>
</div>

<!-- 07 · PULL, on paper this time. -->
<div class="f">
  <div class="lbl muted">Takeaway</div>
  <div class="stack" style="margin-bottom:70px">
    <img src="{{ s.mark_dark }}" style="width:300px;display:block;margin-bottom:44px">
    <div class="say" style="max-width:930px">{{ n.takeaways[1] }}</div>
  </div>
  <div class="pg">07</div>
</div>

<!-- 08 · END CARD. -->
<div class="f ink">
  <div class="lbl muted">Desk view</div>
  <div class="stack" style="margin-bottom:90px">
    <p style="max-width:960px;font-size:34px;line-height:1.44">{{ s.desk_line }}</p>
  </div>
  <div>
    <img src="{{ s.mark_light }}" style="width:300px;display:block;margin-bottom:38px">
    <div class="mark">Andra Markets</div>
    <p class="muted" style="margin-top:22px;font-size:24px;max-width:860px">
      Every US close. Information only, not investment advice.</p>
  </div>
</div>
</body></html>
